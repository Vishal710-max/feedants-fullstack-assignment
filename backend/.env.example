PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/feedants
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# "mock" (default, no keys needed) or "razorpay" (test keys)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

REFERRAL_BASE_URL=https://feedants.com/r
UPLOAD_DIR=./uploads
